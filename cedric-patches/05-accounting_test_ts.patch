+describe("CEDRIC: package cost and batch price tiers", () => {
+  const product = (id: string, unit: string, price: number, category?: any) =>
+    ({ id, code: id, name: id, unit, stock: 0, minStock: 0, price, category }) as any;
+  const baseState = () => {
+    const state = normalizeState({} as any);
+    return {
+      ...state,
+      products: [product("raw", "کیلوگرم", 10), product("pkg", "عدد", 0, "بسته تولید"), product("final", "عدد", 0, "محصول تولیدی")],
+      priceHistory: [],
+      productionRecords: [],
+      productionFormulas: [
+        { id: "f-pkg", name: "pkg", formulaType: "بسته تولید", outputProductId: "pkg", outputQuantity: 1, outputUnit: "عدد",
+          materials: [{ id: "m1", productId: "raw", quantity: 2, unit: "کیلوگرم" }], costs: [], note: "" },
+        { id: "f-final", name: "final", formulaType: "قطعه", outputProductId: "final", outputQuantity: 2, outputUnit: "عدد",
+          materials: [{ id: "m2", productId: "pkg", quantity: 3, unit: "عدد" }], costs: [{ id: "c1", title: "دستمزد", amount: 40 }], note: "" },
+      ],
+    } as any;
+  };
+
+  it("prices a package from its own formula instead of its list price (0)", () => {
+    expect(productCostForFormula(baseState(), "pkg")).toBeCloseTo(20, 6);
+  });
+
+  it("uses the package's formula cost inside a parent formula", () => {
+    const state = baseState();
+    const finalFormula = state.productionFormulas.find((item: any) => item.id === "f-final");
+    // (3 packages x 20 + 40 labour) / 2 pieces = 50
+    expect(estimateFormulaUnitCost(state, finalFormula)).toBeCloseTo(50, 6);
+  });
+
+  it("picks the price tier valid on the invoice date", () => {
+    const record = { id: "b1", unitCost: 100, priceTiers: [
+      { id: "t1", date: "1405/03/01", quantity: 5, unitCost: 120 },
+      { id: "t2", date: "1405/05/01", quantity: 5, unitCost: 150 },
+    ] } as any;
+    expect(productionUnitCostAt(record, "1405/02/15")).toBe(100);
+    expect(productionUnitCostAt(record, "1405/03/01")).toBe(120);
+    expect(productionUnitCostAt(record, "1405/06/10")).toBe(150);
+  });
+});
